# ==============================================================================
# Solar CRM - Root Environment Configuration Template (.env.example)
# Copy to backend/.env and customize for your environment.
# ==============================================================================

# Core Environment & Security
APP_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-solar-crm-2026-key-!
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=solar_crm
DB_USER=solar_user
DB_PASSWORD=your_strong_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Multi-Country Configuration (Phase 8: India & Australia)
ENABLED_COUNTRIES=IN,AU

# Messaging Configuration (WhatsApp & SMS)
WHATSAPP_PROVIDER=console
SMS_PROVIDER=console

# AI Assist Configuration (Phase 7)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=15
AI_MAX_CALLS_PER_USER_PER_DAY=50

# Help Chatbot Configuration (Phase 13)
HELPBOT_PROVIDER=local
HELPBOT_MODEL=claude-haiku-5-5
HELPBOT_TIMEOUT_SECONDS=15
HELPBOT_MAX_QUESTIONS_PER_USER_PER_DAY=50

# Web Push Notifications / VAPID (Phase 11)
VAPID_PUBLIC_KEY=BKm6r7YtnD8h4qgdDFsgGVooJgd5YvNNp2dJ8MyvnWp2g-5l0Gbf7wZ7Q_64dsd_EOcR7xA2OrvEfmGMUiJYDF0
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_ADMIN_EMAIL=admin@solarcrm.com

# Email / SMTP Configuration (Phase 12)
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Solar CRM <noreply@yourdomain.com>"
EMAIL_TIMEOUT=15
