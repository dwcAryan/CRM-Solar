# Solar CRM Backend Environment Variables

DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-solar-crm-2026-key-!
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=solar_crm
DB_USER=solar_user
DB_PASSWORD=your_strong_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Messaging Configuration (WhatsApp & SMS)
WHATSAPP_PROVIDER=console
SMS_PROVIDER=console

# Multi-Country Configuration (Phase 8)
# Comma-separated list of enabled country codes (IN, AU)
ENABLED_COUNTRIES=IN,AU

# AI Assist Configuration
# Options for AI_PROVIDER: "rules" (default, rule-based fallback) or "anthropic" (Anthropic Messages API)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=15
AI_MAX_CALLS_PER_USER_PER_DAY=50

# Web Push (VAPID) Configuration (Phase 11)
VAPID_PUBLIC_KEY=BKm6r7YtnD8h4qgdDFsgGVooJgd5YvNNp2dJ8MyvnWp2g-5l0Gbf7wZ7Q_64dsd_EOcR7xA2OrvEfmGMUiJYDF0
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_ADMIN_EMAIL=admin@solarcrm.com

# Email (SMTP) Configuration (Phase 12)
# In development, leave blank or set EMAIL_BACKEND=console to log emails to console without sending
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Solar CRM <noreply@yourdomain.com>"
EMAIL_TIMEOUT=15

# ==============================================================================
# SMTP Provider Templates (Uncomment and populate for production delivery)
# ==============================================================================
#
# 1. Google Workspace / Gmail (Requires 2-Step Verification & 16-char App Password)
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_16_char_app_password
# DEFAULT_FROM_EMAIL="Solar CRM <your_email@gmail.com>"
#
# 2. Zoho Mail
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.zoho.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=notifications@yourdomain.com
# EMAIL_HOST_PASSWORD=your_zoho_app_password
# DEFAULT_FROM_EMAIL="Solar CRM <notifications@yourdomain.com>"
#
# 3. Brevo (formerly Sendinblue)
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your_brevo_smtp_login
# EMAIL_HOST_PASSWORD=your_brevo_master_or_smtp_key
# DEFAULT_FROM_EMAIL="Solar CRM <alerts@yourdomain.com>"
#
# 4. Amazon SES (Simple Email Service)
# EMAIL_BACKEND=smtp
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your_ses_smtp_username
# EMAIL_HOST_PASSWORD=your_ses_smtp_password
# DEFAULT_FROM_EMAIL="Solar CRM <info@verified-domain.com>"
#
# 5. Microsoft 365 / Outlook
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your_user@outlook.com
# EMAIL_HOST_PASSWORD=your_outlook_password_or_app_secret
# DEFAULT_FROM_EMAIL="Solar CRM <your_user@outlook.com>"

